generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}


model Booking {
  id              String   @id @default(cuid())
  referenceNumber Int      @unique @default(autoincrement())
  name            String   @db.VarChar(120)
  mobile          String   @db.VarChar(32)
  shootType       String   @db.VarChar(80)
  startsAt        DateTime @unique @db.Timestamptz(3)
  location        String   @db.VarChar(300)
  requirements    String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([createdAt], map: "booking_created_at_idx")
  @@map("booking")
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  email     String?  @db.VarChar(254)
  mobile    String?  @db.VarChar(32)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt], map: "enquiry_created_at_idx")
  @@map("enquiry")
}
