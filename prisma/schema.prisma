generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ServiceCategory {
  PHOTOGRAPHY
  FILM
}

model Booking {
  id              String        @id @default(cuid())
  referenceNumber Int           @unique @default(autoincrement())
  name            String        @db.VarChar(120)
  mobile          String        @db.VarChar(32)
  shootType       String        @db.VarChar(80)
  startsAt        DateTime      @unique @db.Timestamptz(3)
  location        String        @db.VarChar(300)
  requirements    String?       @db.Text
  status          BookingStatus @default(PENDING)
  serviceCategory ServiceCategory @default(PHOTOGRAPHY)
  createdAt       DateTime      @default(now())

  @@index([createdAt], map: "booking_created_at_idx")
  @@index([status], map: "booking_status_idx")
  @@index([serviceCategory], map: "booking_service_category_idx")
  @@map("booking")
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  email     String?  @db.VarChar(254)
  mobile    String?  @db.VarChar(32)
  message   String   @db.Text
  serviceType     String?          @db.VarChar(80)
  serviceCategory ServiceCategory?
  createdAt DateTime @default(now())

  @@index([createdAt], map: "enquiry_created_at_idx")
  @@index([serviceCategory], map: "enquiry_service_category_idx")
  @@map("enquiry")
}